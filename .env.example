SECRET_KEY=change-this-to-a-random-secret
DATABASE_URL=sqlite:///eventsphere.db
FLASK_ENV=development

# --- Email (verification + forgot password) ---
# Leave all of these empty while developing: emails are printed in the terminal instead.
# On Render (free plan blocks SMTP) use Brevo's HTTP API:
#   BREVO_API_KEY=your-brevo-api-key
#   MAIL_FROM=the-sender-address-you-verified-in-Brevo@example.com
# On your laptop you can use Gmail SMTP instead (needs an App Password):
#   MAIL_SERVER=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=youraddress@gmail.com
#   MAIL_PASSWORD=your-16-char-app-password
#   MAIL_FROM=youraddress@gmail.com
